# ---------------------------------------------------------------------------
# Pre-Shift Brief — environment configuration
# Copy to .env.local and fill in. Nothing here is required to run the seed
# pipeline EXCEPT ANTHROPIC_API_KEY (and only when you want the AI narrative).
# ---------------------------------------------------------------------------

# --- Claude (required for the generated narrative) -------------------------
ANTHROPIC_API_KEY=
# Default model. Fast/cheap for a daily task. claude-opus-4-8 also available.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Data provider ---------------------------------------------------------
# seed (default, no credentials) | toast (live, needs Toast partner creds)
DATA_PROVIDER=seed

# --- Toast (only when DATA_PROVIDER=toast) ---------------------------------
# e.g. https://ws-api.toasttab.com  (prod)  or  https://ws-sandbox-api.toasttab.com
TOAST_API_HOSTNAME=
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# --- Weather (live, runs today) --------------------------------------------
# nws (US, free, no key — default) | openweather (needs key)
WEATHER_PROVIDER=nws
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060
WEATHER_TIMEZONE=America/New_York
OPENWEATHER_API_KEY=

# --- Email delivery (Resend) -----------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Pre-Shift Brief <brief@example.com>
# Comma-separated recipients.
BRIEF_RECIPIENTS=

# --- Cron protection -------------------------------------------------------
# Shared secret the Vercel cron sends as a Bearer token to /api/cron/send-brief.
# REQUIRED: the cron endpoint fails closed (503) until this is set.
CRON_SECRET=

# --- Dashboard access (HTTP Basic auth) ------------------------------------
# The dashboard + brief APIs expose guest PII. Set BOTH to require a login on
# every page/API (except the cron). If unset, the app is PUBLIC — set these in
# production.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
